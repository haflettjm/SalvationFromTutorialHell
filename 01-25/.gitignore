# Ignore all node_modules anywhere in the repo
**/node_modules/

# Ignore lockfiles from different package managers (adjust if you use only one)
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Ignore logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Ignore .env and related environment files in all projects
**/.env
**/.env.*

# Ignore common output/build directories
**/dist/
**/build/
**/.next/
**/.vercel/
**/.output/
**/.cache/
**/tmp/
**/temp/

# Ignore test coverage
**/coverage/

# Ignore ts build info
**/*.tsbuildinfo

# Editor/IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

